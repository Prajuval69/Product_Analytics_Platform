# Copy this file to .env and choose local-only passwords before Docker startup.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=analytics
PG_USER=analytics
PG_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
